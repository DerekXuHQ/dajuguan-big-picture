  "patterns": {
    "_comment": "Context-sensitive triggers (JavaScript regex, case-insensitive). 'like this/that' as 'of this kind', not 'I like this'; 这种情况 but not 这种情况下.",
    "like this / like that": "(?<!\\b(?:i|we|you|they|he|she|really|don't|do not|didn't|would|i'd|we'd|you'd|actually)\\s)\\blike (?:this|that)\\b",
    "这种情况": "这种情况(?!下)",
    "A、B 这种": "[、，,][^。！？\\n]{0,20}这种(?:情况|问题|东西|的)",
    "like A and B": "(?<!\\b(?:i|we|you|they|he|she|really|don't|do not|didn't|would|i'd|we'd|you'd|actually)\\s)\\blike\\s+(?:the\\s+|a\\s+|an\\s+)?[\\w-]+(?:\\s+[\\w-]+)?\\s*(?:,|\\band\\b|\\bor\\b)",
    "like the X one": "\\blike (?:the|this|that) [\\w-]+ ones?\\b",
    "A、B 那些": "[、，,][^。！？\\n]{0,15}(?:那些|这些东西|这一些|那一类)",
    "这样的问题": "(?:这样|这种|这类|那种|那样)的?(?:问题|情况|错误|bug|毛病|地方|东西)(?!下)",
    "什么 A 啊 B 啊": "什么[^。！？\\n]{1,12}[啊呀][^。！？\\n]{1,12}[啊呀]"
  },
